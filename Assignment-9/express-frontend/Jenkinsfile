pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Umair-bey/tutedude-assignments.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'cd Assignment-9/express-frontend && npm install'
            }
        }
        stage('Deploy') {
            steps {
                sh 'cd Assignment-9/express-frontend && (pm2 restart express-app || pm2 start server.js --name express-app)'
            }
        }
    }
}