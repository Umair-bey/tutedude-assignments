pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Umair-bey/tutedude-assignments.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'cd Assignment-9/flask-backend && pip3 install -r requirements.txt --break-system-packages'
            }
        }
        stage('Deploy') {
            steps {
                sh 'cd Assignment-9/flask-backend && (pm2 restart flask-app || pm2 start app.py --name flask-app --interpreter python3)'
            }
        }
    }
}